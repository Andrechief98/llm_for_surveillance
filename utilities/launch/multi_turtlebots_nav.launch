<launch>
  <!-- Modular navigation framework for multiple worlds -->
  <!-- Usage: roslaunch utilities multi_turtlebots_nav.launch mode:=original -->
  <!-- Options: mode:=original (default), mode:=j1, mode:=j2, mode:=j3 -->

  <arg name="mode" default="original"/>
  <arg name="namespace_robot_1" default="turtlebot3_1"/>
  <arg name="namespace_robot_2" default="turtlebot3_2"/>

  <!-- ============================================================================= -->
  <!-- ORIGINAL WORLD CONFIGURATION -->
  <!-- ============================================================================= -->
  <group if="$(eval arg('mode') == 'original')">
    <arg name="world_file" default="$(find utilities)/worlds/Tim_building_world.world"/>
    
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world_file)"/>
    </include>

    <!-- ROBOT 1 - ORIGINAL WORLD -->
    <group ns="$(arg namespace_robot_1)">
      <param name="tf_prefix" value="$(arg namespace_robot_1)" />
      <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro'" />

      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
      <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>

      <node pkg="map_server" name="map_server" type="map_server" args="$(find utilities)/config/maps/turtlebot3_1_map.yaml">
        <param name="frame_id" value="map" />
      </node>

      <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/common_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/local_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/global_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/local_planner_params.yaml"  command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/global_planner_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/move_base_params.yaml"      command="load"/>

        <param name="global_costmap/robot_base_frame" value="$(arg namespace_robot_1)/base_footprint"/>
        <param name="global_costmap/global_frame"     value="map"/>
        <param name="local_costmap/global_frame"      value="map"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg namespace_robot_1)/base_footprint"/>

        <remap from="cmd_vel" to="cmd_vel"/>
        <remap from="map" to="map"/>
        <remap from="odom" to="odom"/>
      </node>

      <node name="amcl" pkg="amcl" type="amcl" output="screen">
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_sigma_hit" value="0.1"/>
        <param name="laser_z_rand" value="0.01"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="odom_alpha1" value="0.01"/>
        <param name="odom_alpha2" value="0.01"/>
        <param name="odom_alpha3" value="0.02"/>
        <param name="odom_alpha4" value="0.02"/>
        <param name="resample_interval" value="1"/>
        <param name="update_min_d" value="0.2"/>
        <param name="update_min_a" value="0.2"/>
        <param name="base_frame_id" value="$(arg namespace_robot_1)/base_link"/>
        <param name="odom_frame_id" value="$(arg namespace_robot_1)/odom"/>
        <param name="global_frame_id" value="map"/>
      </node>

      <node pkg="rviz" type="rviz" name="rviz" output="screen" args = "-d $(find utilities)/config/rviz/multi_robot_navigation.rviz">
        <remap from="/move_base_simple/goal" to="/turtlebot3_1/move_base_simple/goal"/>
      </node>
    </group>

    <!-- ROBOT 2 - ORIGINAL WORLD -->
    <group ns="$(arg namespace_robot_2)">
      <param name="tf_prefix" value="$(arg namespace_robot_2)" />
      <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro'" />

      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
      <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>

      <node pkg="map_server" name="map_server" type="map_server" args="$(find utilities)/config/maps/turtlebot3_2_map.yaml">
        <param name="frame_id" value="map" />
      </node>

      <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/common_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/local_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/global_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/local_planner_params.yaml"  command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/global_planner_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/move_base_params.yaml"      command="load"/>

        <param name="global_costmap/robot_base_frame" value="$(arg namespace_robot_2)/base_footprint"/>
        <param name="global_costmap/global_frame"      value="map"/>
        <param name="local_costmap/global_frame"      value="map"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg namespace_robot_2)/base_footprint"/>

        <remap from="cmd_vel" to="cmd_vel"/>
        <remap from="map" to="map"/>
        <remap from="odom" to="odom"/>
      </node>

      <node name="amcl" pkg="amcl" type="amcl" output="screen">
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_sigma_hit" value="0.1"/>
        <param name="laser_z_rand" value="0.01"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="odom_alpha1" value="0.01"/>
        <param name="odom_alpha2" value="0.01"/>
        <param name="odom_alpha3" value="0.02"/>
        <param name="odom_alpha4" value="0.02"/>
        <param name="resample_interval" value="1"/>
        <param name="update_min_d" value="0.2"/>
        <param name="update_min_a" value="0.2"/>
        <param name="base_frame_id" value="$(arg namespace_robot_2)/base_link"/>
        <param name="odom_frame_id" value="$(arg namespace_robot_2)/odom"/>
        <param name="global_frame_id" value="map"/>
      </node>
    </group>
  </group>

  <!-- ============================================================================= -->
  <!-- J1 WORLD CONFIGURATION -->
  <!-- ============================================================================= -->
  <group if="$(eval arg('mode') == 'j1')">
    <arg name="world_file" default="$(find utilities)/worlds/jamarworld.world"/>
    
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world_file)"/>
    </include>

    <!-- ROBOT 1 - J1 WORLD -->
    <group ns="$(arg namespace_robot_1)">
      <param name="tf_prefix" value="$(arg namespace_robot_1)" />
      <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro'" />

      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
      <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>
      
      <node pkg="gazebo_ros" type="spawn_model" name="spawn_turtlebot3" output="screen"
            args="-urdf -model turtlebot3_1 -x 0.0 -y -4.5 -Y 1.57 -param robot_description"/>

      <node pkg="map_server" name="map_server" type="map_server" args="$(find utilities)/config/maps/turtlebot3_1_mapj1.yaml">
        <param name="frame_id" value="map" />
      </node>

      <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/common_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/local_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/global_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/local_planner_params.yaml"  command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/global_planner_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/move_base_params.yaml"      command="load"/>

        <param name="global_costmap/robot_base_frame" value="$(arg namespace_robot_1)/base_footprint"/>
        <param name="global_costmap/global_frame"     value="map"/>
        <param name="local_costmap/global_frame"      value="map"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg namespace_robot_1)/base_footprint"/>

        <remap from="cmd_vel" to="cmd_vel"/>
        <remap from="map" to="map"/>
        <remap from="odom" to="odom"/>
      </node>

      <node name="amcl" pkg="amcl" type="amcl" output="screen">
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_sigma_hit" value="0.1"/>
        <param name="laser_z_rand" value="0.01"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="odom_alpha1" value="0.01"/>
        <param name="odom_alpha2" value="0.01"/>
        <param name="odom_alpha3" value="0.02"/>
        <param name="odom_alpha4" value="0.02"/>
        <param name="resample_interval" value="1"/>
        <param name="update_min_d" value="0.2"/>
        <param name="update_min_a" value="0.2"/>
        <param name="base_frame_id" value="$(arg namespace_robot_1)/base_link"/>
        <param name="odom_frame_id" value="$(arg namespace_robot_1)/odom"/>
        <param name="global_frame_id" value="map"/>
      </node>

      <node pkg="rviz" type="rviz" name="rviz" output="screen" args = "-d $(find utilities)/config/rviz/multi_robot_navigation.rviz">
        <remap from="/move_base_simple/goal" to="/turtlebot3_1/move_base_simple/goal"/>
      </node>
    </group>

    <!-- ROBOT 2 - J1 WORLD -->
    <group ns="$(arg namespace_robot_2)">
      <param name="tf_prefix" value="$(arg namespace_robot_2)" />
      <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro'" />

      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
      <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>

      <node pkg="gazebo_ros" type="spawn_model" name="spawn_turtlebot3" output="screen"
            args="-urdf -model turtlebot3_2 -x 0.0 -y 3.5 -Y -1.57 -param robot_description"/>

      <node pkg="map_server" name="map_server" type="map_server" args="$(find utilities)/config/maps/turtlebot3_2_mapj1.yaml">
        <param name="frame_id" value="map" />
      </node>

      <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/common_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/local_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/global_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/local_planner_params.yaml"  command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/global_planner_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/move_base_params.yaml"      command="load"/>

        <param name="global_costmap/robot_base_frame" value="$(arg namespace_robot_2)/base_footprint"/>
        <param name="global_costmap/global_frame"      value="map"/>
        <param name="local_costmap/global_frame"      value="map"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg namespace_robot_2)/base_footprint"/>

        <remap from="cmd_vel" to="cmd_vel"/>
        <remap from="map" to="map"/>
        <remap from="odom" to="odom"/>
      </node>

      <node name="amcl" pkg="amcl" type="amcl" output="screen">
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_sigma_hit" value="0.1"/>
        <param name="laser_z_rand" value="0.01"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="odom_alpha1" value="0.01"/>
        <param name="odom_alpha2" value="0.01"/>
        <param name="odom_alpha3" value="0.02"/>
        <param name="odom_alpha4" value="0.02"/>
        <param name="resample_interval" value="1"/>
        <param name="update_min_d" value="0.2"/>
        <param name="update_min_a" value="0.2"/>
        <param name="base_frame_id" value="$(arg namespace_robot_2)/base_link"/>
        <param name="odom_frame_id" value="$(arg namespace_robot_2)/odom"/>
        <param name="global_frame_id" value="map"/>
      </node>
    </group>
  </group>

  <!-- ============================================================================= -->
  <!-- J2 WORLD CONFIGURATION -->
  <!-- ============================================================================= -->
  <group if="$(eval arg('mode') == 'j2')">
    <arg name="world_file" default="$(find utilities)/worlds/jamarworld2.world"/>
    
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world_file)"/>
    </include>

    <!-- ROBOT 1 - J2 WORLD -->
    <group ns="$(arg namespace_robot_1)">
      <param name="tf_prefix" value="$(arg namespace_robot_1)" />
      <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro'" />

      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
      <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>
      
      <node pkg="gazebo_ros" type="spawn_model" name="spawn_turtlebot3" output="screen"
            args="-urdf -model turtlebot3_1 -x -4.0 -y -4.5 -Y 1.57 -param robot_description"/>

      <node pkg="map_server" name="map_server" type="map_server" args="$(find utilities)/config/maps/turtlebot3_1_mapj2.yaml">
        <param name="frame_id" value="map" />
      </node>

      <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/common_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/local_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/global_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/local_planner_params.yaml"  command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/global_planner_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/move_base_params.yaml"      command="load"/>

        <param name="global_costmap/robot_base_frame" value="$(arg namespace_robot_1)/base_footprint"/>
        <param name="global_costmap/global_frame"     value="map"/>
        <param name="local_costmap/global_frame"      value="map"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg namespace_robot_1)/base_footprint"/>

        <remap from="cmd_vel" to="cmd_vel"/>
        <remap from="map" to="map"/>
        <remap from="odom" to="odom"/>
      </node>

      <node name="amcl" pkg="amcl" type="amcl" output="screen">
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_sigma_hit" value="0.1"/>
        <param name="laser_z_rand" value="0.01"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="odom_alpha1" value="0.01"/>
        <param name="odom_alpha2" value="0.01"/>
        <param name="odom_alpha3" value="0.02"/>
        <param name="odom_alpha4" value="0.02"/>
        <param name="resample_interval" value="1"/>
        <param name="update_min_d" value="0.2"/>
        <param name="update_min_a" value="0.2"/>
        <param name="base_frame_id" value="$(arg namespace_robot_1)/base_link"/>
        <param name="odom_frame_id" value="$(arg namespace_robot_1)/odom"/>
        <param name="global_frame_id" value="map"/>
      </node>

      <node pkg="rviz" type="rviz" name="rviz" output="screen" args = "-d $(find utilities)/config/rviz/multi_robot_navigation.rviz">
        <remap from="/move_base_simple/goal" to="/turtlebot3_1/move_base_simple/goal"/>
      </node>
    </group>

    <!-- ROBOT 2 - J2 WORLD -->
    <group ns="$(arg namespace_robot_2)">
      <param name="tf_prefix" value="$(arg namespace_robot_2)" />
      <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro'" />

      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
      <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>

      <node pkg="gazebo_ros" type="spawn_model" name="spawn_turtlebot3" output="screen"
            args="-urdf -model turtlebot3_2 -x 0.0 -y 3.5 -Y -1.57 -param robot_description"/>

      <node pkg="map_server" name="map_server" type="map_server" args="$(find utilities)/config/maps/turtlebot3_2_mapj2.yaml">
        <param name="frame_id" value="map" />
      </node>

      <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/common_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/local_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/global_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/local_planner_params.yaml"  command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/global_planner_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/move_base_params.yaml"      command="load"/>

        <param name="global_costmap/robot_base_frame" value="$(arg namespace_robot_2)/base_footprint"/>
        <param name="global_costmap/global_frame"      value="map"/>
        <param name="local_costmap/global_frame"      value="map"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg namespace_robot_2)/base_footprint"/>

        <remap from="cmd_vel" to="cmd_vel"/>
        <remap from="map" to="map"/>
        <remap from="odom" to="odom"/>
      </node>

      <node name="amcl" pkg="amcl" type="amcl" output="screen">
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_sigma_hit" value="0.1"/>
        <param name="laser_z_rand" value="0.01"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="odom_alpha1" value="0.01"/>
        <param name="odom_alpha2" value="0.01"/>
        <param name="odom_alpha3" value="0.02"/>
        <param name="odom_alpha4" value="0.02"/>
        <param name="resample_interval" value="1"/>
        <param name="update_min_d" value="0.2"/>
        <param name="update_min_a" value="0.2"/>
        <param name="base_frame_id" value="$(arg namespace_robot_2)/base_link"/>
        <param name="odom_frame_id" value="$(arg namespace_robot_2)/odom"/>
        <param name="global_frame_id" value="map"/>
      </node>
    </group>
  </group>

  <!-- ============================================================================= -->
  <!-- J3 WORLD CONFIGURATION -->
  <!-- ============================================================================= -->
  <group if="$(eval arg('mode') == 'j3')">
    <arg name="world_file" default="$(find utilities)/worlds/jamarworld3.world"/>
    
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world_file)"/>
    </include>

    <!-- ROBOT 1 - J3 WORLD -->
    <group ns="$(arg namespace_robot_1)">
      <param name="tf_prefix" value="$(arg namespace_robot_1)" />
      <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro'" />

      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
      <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>
      
      <node pkg="gazebo_ros" type="spawn_model" name="spawn_turtlebot3" output="screen"
            args="-urdf -model turtlebot3_1 -x 0.0 -y -4.5 -Y 1.57 -param robot_description"/>

      <node pkg="map_server" name="map_server" type="map_server" args="$(find utilities)/config/maps/turtlebot3_1_mapj3.yaml">
        <param name="frame_id" value="map" />
      </node>

      <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/common_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/local_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/global_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/local_planner_params.yaml"  command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/global_planner_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_1/move_base_params.yaml"      command="load"/>

        <param name="global_costmap/robot_base_frame" value="$(arg namespace_robot_1)/base_footprint"/>
        <param name="global_costmap/global_frame"     value="map"/>
        <param name="local_costmap/global_frame"      value="map"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg namespace_robot_1)/base_footprint"/>

        <remap from="cmd_vel" to="cmd_vel"/>
        <remap from="map" to="map"/>
        <remap from="odom" to="odom"/>
      </node>

      <node name="amcl" pkg="amcl" type="amcl" output="screen">
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_sigma_hit" value="0.1"/>
        <param name="laser_z_rand" value="0.01"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="odom_alpha1" value="0.01"/>
        <param name="odom_alpha2" value="0.01"/>
        <param name="odom_alpha3" value="0.02"/>
        <param name="odom_alpha4" value="0.02"/>
        <param name="resample_interval" value="1"/>
        <param name="update_min_d" value="0.2"/>
        <param name="update_min_a" value="0.2"/>
        <param name="base_frame_id" value="$(arg namespace_robot_1)/base_link"/>
        <param name="odom_frame_id" value="$(arg namespace_robot_1)/odom"/>
        <param name="global_frame_id" value="map"/>
      </node>

      <node pkg="rviz" type="rviz" name="rviz" output="screen" args = "-d $(find utilities)/config/rviz/multi_robot_navigation.rviz">
        <remap from="/move_base_simple/goal" to="/turtlebot3_1/move_base_simple/goal"/>
      </node>
    </group>

    <!-- ROBOT 2 - J3 WORLD -->
    <group ns="$(arg namespace_robot_2)">
      <param name="tf_prefix" value="$(arg namespace_robot_2)" />
      <param name="robot_description" command="$(find xacro)/xacro '$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro'" />

      <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
      <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>

      <node pkg="gazebo_ros" type="spawn_model" name="spawn_turtlebot3" output="screen"
            args="-urdf -model turtlebot3_2 -x 0.0 -y 3.5 -Y -1.57 -param robot_description"/>

      <node pkg="map_server" name="map_server" type="map_server" args="$(find utilities)/config/maps/turtlebot3_2_mapj3.yaml">
        <param name="frame_id" value="map" />
      </node>

      <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/common_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/local_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/global_costmap_all_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/local_planner_params.yaml"  command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/global_planner_params.yaml" command="load"/>
        <rosparam file="$(find utilities)/config/move_base/turtlebot3_2/move_base_params.yaml"      command="load"/>

        <param name="global_costmap/robot_base_frame" value="$(arg namespace_robot_2)/base_footprint"/>
        <param name="global_costmap/global_frame"      value="map"/>
        <param name="local_costmap/global_frame"      value="map"/>
        <param name="local_costmap/robot_base_frame"  value="$(arg namespace_robot_2)/base_footprint"/>

        <remap from="cmd_vel" to="cmd_vel"/>
        <remap from="map" to="map"/>
        <remap from="odom" to="odom"/>
      </node>

      <node name="amcl" pkg="amcl" type="amcl" output="screen">
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="3000"/>
        <param name="laser_z_hit" value="0.95"/>
        <param name="laser_sigma_hit" value="0.1"/>
        <param name="laser_z_rand" value="0.01"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="odom_alpha1" value="0.01"/>
        <param name="odom_alpha2" value="0.01"/>
        <param name="odom_alpha3" value="0.02"/>
        <param name="odom_alpha4" value="0.02"/>
        <param name="resample_interval" value="1"/>
        <param name="update_min_d" value="0.2"/>
        <param name="update_min_a" value="0.2"/>
        <param name="base_frame_id" value="$(arg namespace_robot_2)/base_link"/>
        <param name="odom_frame_id" value="$(arg namespace_robot_2)/odom"/>
        <param name="global_frame_id" value="map"/>
      </node>
    </group>
  </group>

</launch>