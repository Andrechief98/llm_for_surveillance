<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Modelli di base -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Muro Verticale: dimensione (spessore x larghezza x altezza) 0.1 x 4 x 2, centrato in (0,0,1) -->
    <model name="wall">
      <static>true</static>
      <link name="wall_link">
        <pose>0 0 1 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4 2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Camera 1: modello a forma di box con sensore fish‑eye, attaccata al muro -->
    <model name="camera1">
      <static>true</static>
      <link name="camera_link">
        <!-- Posizionata in modo da essere "incollata" al muro: 
             x = -0.15 (leggermente davanti al muro, che è a x=0),
             y = -1 (a sinistra sul muro),
             z = 1.2 (stessa altezza per entrambe) -->
        <pose>0.15 -1 1.2 0 0 0</pose>
        <!-- Definizione del box fisico per la telecamera -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.1 0.1 0.8 1</diffuse>
          </material>
        </visual>
        <!-- Sensore camera con effetto fish‑eye -->
        <sensor name="camera_sensor1" type="camera">
          <update_rate>30</update_rate>
          <camera>
            <!-- Campo visivo aumentato per effetto fish‑eye -->
            <horizontal_fov>2.5</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
            <!-- Parametri di distorsione -->
            <distortion>
              <k1>-0.3</k1>
              <k2>0.1</k2>
              <p1>0</p1>
              <p2>0</p2>
            </distortion>
          </camera>
          <plugin name="camera_plugin" filename="libcamera_plugin.so"/>
        </sensor>
      </link>
    </model>

    <!-- Camera 2: modello a forma di box con sensore fish‑eye, attaccata al muro -->
    <model name="camera2">
      <static>true</static>
      <link name="camera_link">
        <!-- Posizionata simmetricamente rispetto alla Camera 1 sul muro:
             x = -0.15,
             y = 1,
             z = 1.2 -->
        <pose>0.15 1 1.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <!-- Sensore camera fish‑eye -->
        <sensor name="camera_sensor2" type="camera">
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>2.5</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
            <distortion>
              <k1>-0.3</k1>
              <k2>0.1</k2>
              <p1>0</p1>
              <p2>0</p2>
            </distortion>
          </camera>
          <plugin name="camera_plugin" filename="libcamera_plugin.so"/>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
