<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Muro sinistro -->
    <model name="left_wall">
      <static>true</static>
      <!-- Centro a x = -0.75 -->
      <pose>-0.75 0 1.5 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 3 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 3 3</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Muro destro -->
    <model name="right_wall">
      <static>true</static>
      <!-- Centro a x = 0.75 -->
      <pose>0.75 0 1.5 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 3 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 3 3</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Porta attaccata al muro sinistro -->
    <model name="door_left">
      <!-- Il frame della porta è fissato al muro sinistro -->
      <pose>-0.75 0 1.5 0 0 0</pose>
      <link name="door_frame">
        <pose>0 0 0 0 0 0</pose>
      </link>
      <link name="door">
        <!-- Imposta il link come kinematico per il controllo diretto -->
        <kinematic>true</kinematic>
        <pose>0 0 0 0 0 0</pose>
        <visual name="door_visual">
          <geometry>
            <box>
              <!-- Dimensioni della porta: larghezza 1 m, spessore 0.05 m, altezza 3 m -->
              <size>1 0.05 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.3 0.3 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="door_collision">
          <geometry>
            <box>
              <size>1 0.05 3</size>
            </box>
          </geometry>
        </collision>
      </link>
      <!-- Giunto prismatic: la porta scorre lungo l'asse x verso sinistra per aprirsi -->
      <joint name="door_joint" type="prismatic">
        <parent>door_frame</parent>
        <child>door</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <!-- Poiché la porta è attaccata al muro sinistro, il movimento di apertura è verso sinistra -->
          <xyz>-1 0 0</xyz>
          <limit>
            <lower>0</lower>
            <upper>1.0</upper>
          </limit>
        </axis>
      </joint>
      <!-- Plugin per il controllo della porta -->
      <plugin name="door_control_plugin" filename="libdoor_control_plugin.so">
        <door_joint>door_joint</door_joint>
        <speed>1.0</speed>
        <open_target>1.0</open_target>
        <close_target>0.0</close_target>
      </plugin>
    </model>

    <!-- Porta attaccata al muro destro -->
    <model name="door_right">
      <pose>0.75 0 1.5 0 0 0</pose>
      <link name="door_frame">
        <pose>0 0 0 0 0 0</pose>
      </link>
      <link name="door">
        <kinematic>true</kinematic>
        <pose>0 0 0 0 0 0</pose>
        <visual name="door_visual">
          <geometry>
            <box>
              <size>1 0.05 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.9 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="door_collision">
          <geometry>
            <box>
              <size>1 0.05 3</size>
            </box>
          </geometry>
        </collision>
      </link>
      <joint name="door_joint" type="prismatic">
        <parent>door_frame</parent>
        <child>door</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <!-- Per il muro destro, il movimento di apertura avviene lungo x positivo -->
          <xyz>1 0 0</xyz>
          <limit>
            <lower>0</lower>
            <upper>1.0</upper>
          </limit>
        </axis>
      </joint>
      <plugin name="door_control_plugin" filename="libdoor_control_plugin.so">
        <door_joint>door_joint</door_joint>
        <speed>1.0</speed>
        <open_target>1.0</open_target>
        <close_target>0.0</close_target>
      </plugin>
    </model>

  </world>
</sdf>
