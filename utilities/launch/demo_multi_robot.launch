<launch>

    <!-- 
    world_id specifies the type of desidered environment for the simulation 
        1 = first world (map1)
        2 = second world (map2) 
        -->
    <arg name="world_id" default="2"/> 

    <param name="/world_id" value="$(arg world_id)"/>

    <!-- Running the node for Rviz markers -->
    <node 
        name="markerVisualizationNode" 
        pkg="utilities" 
        type="marker_visualization_node.py" 
        output="screen">
    </node>

    <!-- Launching Gazebo simultion -->
    <include file="$(find utilities)/launch/multi_turtlebots_nav.launch">
        <arg name="world_id" value="$(arg world_id)"/>
    </include>
    <include file="$(find utilities)/launch/demo_teleop.launch" />

    <!-- Running the node to initialize turtlebot positions -->
    <node 
        name="initializationNode" 
        pkg="utilities" 
        type="turtlebotsInitialization.py" 
        output="screen">
    </node>
    
    <!-- <node 
        name="chatNode" 
        pkg="OpenAI_interface" 
        type="app_ros.py" 
        output="screen">
    </node> -->


    <node 
        name="dataMediatorNode" 
        pkg="utilities" 
        type="data_mediator.py" 
        output="screen">
    </node>

    <node 
        name="sensors_activation_node" 
        pkg="utilities" 
        type="sensors_activation_node.py" 
        output="screen">
    </node>

    <node 
        name="check_robot_goal_node" 
        pkg="utilities" 
        type="check_robot_goal.py" 
        output="screen">
    </node>




    

</launch>